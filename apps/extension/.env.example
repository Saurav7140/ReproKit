# Optional overrides. By default, the build reuses the dashboard's PUBLIC URL/key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
VITE_DASHBOARD_ORIGIN=http://127.0.0.1:5173
# Never place a secret/service-role key here. Rebuild and reload the extension after changes.
