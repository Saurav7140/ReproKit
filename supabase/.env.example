# Optional live acceptance test ONLY, in a dedicated test Supabase project.
# Copy to supabase/.env.test, never to the dashboard or a VITE_ variable.
# The test creates two synthetic confirmed accounts and removes its own test data.
REPROKIT_TEST_PROJECT_REF=YOUR_PROJECT_REF
REPROKIT_TEST_SECRET_KEY=
# Same secret as the deployed function. Cleanup affects all expired work in this project.
REPROKIT_CLEANUP_SECRET=
